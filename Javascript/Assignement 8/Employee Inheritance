
class Employee {

    constructor(name, department) {
        this.name = name;
        this.department = department;
    }

    work() {
        console.log(this.name, "is performing general employee tasks.");
    }
}

class Manager extends Employee {

    constructor(name, department) {
        super(name, department);
    }

    // Overriding parent class method
    work() {
        console.log(this.name, "is managing the team in", this.department);
    }
}

// Creating objects
let emp1 = new Employee("Rahul", "IT");

let emp2 = new Manager("Priya", "HR");

// Runtime polymorphism
let employees = [emp1, emp2];

employees.forEach(emp => {
    emp.work();
});

